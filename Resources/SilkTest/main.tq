from Std.Console import

from Dotnet.System import
from Dotnet.Silk.NET.Windowing import
from Dotnet.Silk.NET.OpenGL import
from Dotnet.Silk.NET.Maths import { Vector2D }

let *IWindow window
let *GL gl

let uint vao
let uint vbo

@public func main() {
	let windowOptions = WindowOptions.Default
	{
		windowOptions.Size = new Vector2D(int)(1000, 600)
		windowOptions.Title = "Silk Test"
	}

	window = Window.Create(windowOptions)

	let view = window as *IView
	view.Load += onLoad
	view.Update += onUpdate
	view.Render += onRender

	WindowExtensions.Run(window)
}

func onLoad() {
	gl = ContextSourceExtensions.CreateOpenGL(window)
	
	vao = gl.GenVertexArray()
	gl.BindVertexArray(vao)

	let [12]f32 vertices = [
		 0.5,  0.5, 0.0,
		 0.5, -0.5, 0.0,
		-0.5, -0.5, 0.0,
		-0.5,  0.5, 0.0
	]
	
	vbo = gl.GenBuffer()
	gl.BindBuffer(BufferTargetARB.ArrayBuffer, vbo)

	gl.BufferData(
		f32,
		BufferTargetARB.ArrayBuffer,
		vertices.len * 4, # sizeof(float)
		&vertices,
		BuferUsageARB.StaticDraw
	)
}

func onUpdate(f64 delta) {

}

func onRender(f64 delta) {
	gl.ClearColor(0.3882353, 0.58431375, 0.93333334, 1.0)
	gl.Clear(ClearBufferMask.ColorBufferBit)
}
