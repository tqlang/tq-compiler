from Std.Console import

from Silk.Silk.NET.Windowing import
from Silk.Silk.NET.Maths import { Vector2D }

let IWindow window

@public func main() {
	writeln("Hello, World!")

	let windowOptions = WindowOptions.Default
	{
		windowOptions.Size = new Vector2D(int)(1000, 600)
		windowOptions.Title = "Silk Test"
	}

	window = Window.Create(windowOptions)

	#window.add_Load(onLoad)
	#window.add_Update(onUpdate)
	#window.add_Render(onRender)

	WindowExtensions.Run(window)
}

func onLoad() {
	writeln("Loaded!")
}

func onUpdate(f64 delta) {
	writeln("Update!")
}

func onRender(f64 delta) {
	writeln("Render!")
}
