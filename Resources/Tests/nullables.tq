from Std import { Test }

func testNullables() {
    Test.newTestUnit("nullability - coalescing operator with null")
    {
        let ?int maybeNull = null
        let int safeVal = maybeNull ?? 42
        Test.assert(safeVal, 42)
    }

    Test.newTestUnit("nullability - coalescing operator with valid value")
    {
        let ?int maybeNull = getNullableValue(100)
        let int unwrappedVal = maybeNull ?? 0
        Test.assert(unwrappedVal, 100)
    }

    Test.newTestUnit("nullability - unwrap operator")
    {
        let ?int validNum = getNullableValue(55)
        let int manualUnwrap = validNum.unwrap() #.?
        Test.assert(manualUnwrap, 55)
    }

    Test.newTestUnit("nullability - explicit unwrap method")
    {
        let ?int validNum = getNullableValue(30)
        let int manualUnwrap = validNum.unwrap()
        Test.assert(manualUnwrap, 30)
    }
}

func getNullableValue(int num) ?int => num
