from Std import { Test }
from Dotnet.System import { Int32 }

let int calls = 0

func twice(int number) int => number * 2

func add(int a, int b) int => a + b

func hit() => calls++

func hitAndForget() => hit()

func pick(type T, T first, T second, bool useFirst) T => match useFirst {
    case true => first
    case false => second
}

# Every path returns, with no `return` at the end.
func sign(i32 v) i32 {
    if v > 0 { return 1 }
    elif v < 0 { return -1 }
    else { return 0 }
}

func firstAbove(i32 limit) i32 {
    let i32 n = 0
    while true {
        if n > limit { return n }
        n = n + 1
    }
}

# Every path assigns `kind` before it is used.
func assignedLater(i32 v) i32 {
    let i32 kind
    if v > 0 { kind = 1 }
    elif v < 0 { kind = 2 }
    else { kind = 3 }
    return kind
}

@public func testFunctions() {
    Test.newTestUnit("Builtins - functions - a variable assigned later")
    {
        Test.assert(assignedLater(5) * 100 + assignedLater(-5) * 10 + assignedLater(0), 123)

        let int parsed
        Test.assert(Int32.TryParse("42", &parsed), true)
        Test.assert(parsed, 42)
    }

    Test.newTestUnit("Builtins - functions - every path returns")
    {
        Test.assert(sign(-5) + sign(7) * 10, 9)
        Test.assert(firstAbove(3), 4)
    }

    Test.newTestUnit("Builtins - functions - body with =>")
    {
        Test.assert(twice(21), 42)
        Test.assert(add(2, 3), 5)
    }

    Test.newTestUnit("Builtins - functions - => without a return type runs the expression")
    {
        calls = 0
        hitAndForget()
        hitAndForget()
        Test.assert(calls, 2)
    }

    Test.newTestUnit("Builtins - functions - generic function with => and explicit type")
    {
        Test.assert(pick(int, 1, 2, true), 1)
        Test.assert(pick(int, 1, 2, false), 2)
        Test.assert(pick(string, "a", "b", false), "b")
    }
}
