from Std import { Test }

let int calls = 0

func twice(int number) int => number * 2

func add(int a, int b) int => a + b

func hit() => calls++

func hitAndForget() => hit()

func pick(type T, T first, T second, bool useFirst) T => match useFirst {
    case true => first
    case false => second
}

@public func testFunctions() {
    Test.newTestUnit("Builtins - functions - body with =>")
    {
        Test.assert(twice(21), 42)
        Test.assert(add(2, 3), 5)
    }

    Test.newTestUnit("Builtins - functions - => without a return type runs the expression")
    {
        calls = 0
        hitAndForget()
        hitAndForget()
        Test.assert(calls, 2)
    }

    Test.newTestUnit("Builtins - functions - generic function with => and explicit type")
    {
        Test.assert(pick(int, 1, 2, true), 1)
        Test.assert(pick(int, 1, 2, false), 2)
        Test.assert(pick(string, "a", "b", false), "b")
    }
}
