from Std import { Test }

# structs by value: no @class. The hierarchy is kept by the backend, and the polymorphism goes through `*S`.

struct Vehicle {
    let int wheels = 4
    let string plate = "none"

    @virtual func sound() string => "..."
    @virtual func describe() string => "vehicle"
    func wheelCount() int => wheels
}

struct Car extends Vehicle {
    @override func sound() string => "vroom"
}

struct Pickup extends Car {
    @override func describe() string => "pickup"
}

struct Bike extends Vehicle {
    @override func sound() string => "ring"
    @override func describe() string => "bike"
}

func soundOfRef(*Vehicle vehicle) string => vehicle.sound()

func describeOfRef(*Vehicle vehicle) string => vehicle.describe()

func renameRef(*Vehicle vehicle, string plate) { vehicle.plate = plate }

func renameCopy(Car car, string plate) { car.plate = plate }

func asVehicle(*Car car) *Vehicle => car

func totalWheels(*Vehicle first, *Vehicle second) int => first.wheels + second.wheels

func kindOfRef(*Vehicle vehicle) string => "vehicle"

func kindOfRef(*Car car) string => "car"


@public func testValueInheritance() {
    Test.newTestUnit("Builtins - inheritance by value - a struct that extends another has its functions")
    {
        let Car car = new Car()
        Test.assert(car.describe(), "vehicle")
        Test.assert(car.wheelCount(), 4)
    }

    Test.newTestUnit("Builtins - inheritance by value - the fields come from what is extended")
    {
        let Car car = new Car()
        Test.assert(car.wheels, 4)
        Test.assert(car.plate, "none")

        car.plate = "abc"
        car.wheels = 6
        Test.assert(car.plate, "abc")
        Test.assert(car.wheelCount(), 6)
    }

    Test.newTestUnit("Builtins - inheritance by value - override changes what a function does")
    {
        let Vehicle vehicle = new Vehicle()
        let Car car = new Car()
        let Bike bike = new Bike()

        Test.assert(vehicle.sound(), "...")
        Test.assert(car.sound(), "vroom")
        Test.assert(bike.sound(), "ring")
    }

    Test.newTestUnit("Builtins - inheritance by value - several levels")
    {
        let Pickup pickup = new Pickup()

        Test.assert(pickup.sound(), "vroom")
        Test.assert(pickup.describe(), "pickup")
        Test.assert(pickup.wheelCount(), 4)

        pickup.plate = "xyz"
        Test.assert(pickup.plate, "xyz")
    }

    Test.newTestUnit("Builtins - inheritance by value - a value is copied when it is assigned")
    {
        let Car first = new Car()
        let Car second = first

        second.wheels = 8
        second.plate = "copy"

        Test.assert(first.wheels, 4)
        Test.assert(first.plate, "none")
        Test.assert(second.wheels, 8)
    }
}

@public func testValuePolymorphism() {
    Test.newTestUnit("Builtins - polymorphism by value - a reference to the derived goes where the base is expected")
    {
        let Car car = new Car()
        let *Car carRef = &car
        let *Vehicle vehicle = carRef

        Test.assert(vehicle.sound(), "vroom")
        Test.assert(vehicle.wheelCount(), 4)
    }

    Test.newTestUnit("Builtins - polymorphism by value - the override that runs is the one of the value")
    {
        let Pickup pickup = new Pickup()
        let *Pickup pickupRef = &pickup
        let *Vehicle vehicle = pickupRef

        Test.assert(vehicle.sound(), "vroom")
        Test.assert(vehicle.describe(), "pickup")
    }

    Test.newTestUnit("Builtins - polymorphism by value - the same function with every derived struct")
    {
        let Vehicle base = new Vehicle()
        let Car car = new Car()
        let Pickup pickup = new Pickup()
        let Bike bike = new Bike()

        Test.assert(describeOfRef(&base), "vehicle")
        Test.assert(describeOfRef(&car), "vehicle")
        Test.assert(describeOfRef(&pickup), "pickup")
        Test.assert(describeOfRef(&bike), "bike")
        Test.assert(soundOfRef(&bike), "ring")
    }

    Test.newTestUnit("Builtins - polymorphism by value - the reference to the base is the same object as the one to the derived")
    {
        let Car car = new Car()
        let *Car carRef = &car
        let *Vehicle vehicle = carRef
        vehicle.plate = "ref"

        Test.assert(carRef.plate, "ref")

        carRef.wheels = 6
        Test.assert(vehicle.wheels, 6)
    }

    Test.newTestUnit("Builtins - polymorphism by value - a function that receives the reference changes the object")
    {
        let Pickup pickup = new Pickup()
        let *Pickup pickupRef = &pickup

        renameRef(pickupRef, "toy")
        Test.assert(pickupRef.plate, "toy")
    }

    Test.newTestUnit("Builtins - polymorphism by value - a function that receives the value changes a copy")
    {
        let Car car = new Car()
        renameCopy(car, "other")
        Test.assert(car.plate, "none")
    }

    Test.newTestUnit("Builtins - polymorphism by value - a reference as the result of a function")
    {
        let Car car = new Car()
        let *Car carRef = &car
        let *Vehicle vehicle = asVehicle(carRef)

        Test.assert(vehicle.sound(), "vroom")

        vehicle.plate = "back"
        Test.assert(carRef.plate, "back")
    }

    Test.newTestUnit("Builtins - polymorphism by value - two references of different derived structs")
    {
        let Car car = new Car()
        let Bike bike = new Bike()
        bike.wheels = 2

        Test.assert(totalWheels(&car, &bike), 6)
    }

    Test.newTestUnit("Builtins - polymorphism by value - the overload with the nearest base is chosen")
    {
        let Vehicle vehicle = new Vehicle()
        let Bike bike = new Bike()
        let Car car = new Car()
        let Pickup pickup = new Pickup()

        Test.assert(kindOfRef(&vehicle), "vehicle")
        Test.assert(kindOfRef(&bike), "vehicle")
        Test.assert(kindOfRef(&car), "car")
        Test.assert(kindOfRef(&pickup), "car")
    }

    Test.newTestUnit("Builtins - polymorphism by value - a reference to the base goes back to the derived with as")
    {
        let Car car = new Car()
        car.plate = "cast"
        let *Car carRef = &car
        let *Vehicle vehicle = carRef
        let *Car back = vehicle as *Car
        
        Test.assert(back.plate, "cast")
        Test.assert(back.sound(), "vroom")
    }
}
