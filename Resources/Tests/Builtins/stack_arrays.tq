from Std import { Test }

# `[N]T` of a variable is a block of the stack of the function (`stackalloc`) when its elements hold no reference; otherwise it is an array
# of the heap. `[]T` is a view (a `Slice<T>`) of either.
struct Pixel {
    let u8 red = 0
    let u8 green = 0
}

func fillView([]u8 view, u8 value) {
    let int index = 0
    while index < view.len {
        view[index] = value
        index = index + 1
    }
}

func sumOf([]i32 view) i32 {
    let i32 total = 0
    let int index = 0
    while index < view.len {
        total = total + view[index]
        index = index + 1
    }
    return total
}

@public func testStackArrays() {
    Test.newTestUnit("Builtins - stack arrays - a variable that is an array holds its elements")
    {
        let [4]i32 values
        Test.assert(values.len, 4)
        Test.assert(values[0], 0)

        values[1] = 20
        values[3] = 40
        Test.assert(values[1], 20)
        Test.assert(values[3], 40)
        Test.assert(sumOf(&values), 60)
    }

    Test.newTestUnit("Builtins - stack arrays - a literal fills the array, and a view of it writes into it")
    {
        let [3]u8 bytes = [1, 2, 3]
        Test.assert(bytes[2], 3)

        fillView(&bytes, 7)
        Test.assert(bytes[0], 7)
        Test.assert(bytes[2], 7)

        let []u8 part = bytes[1 .. 2]
        part[0] = 9
        Test.assert(bytes[1], 9)
        Test.assert(part.len, 2)
    }

    Test.newTestUnit("Builtins - stack arrays - an array that is declared in a loop is zeroed again and does not grow the stack")
    {
        let int turn = 0
        let int dirty = 0
        while turn < 200000 {
            let [1024]u8 buffer
            if buffer[0] != 0 {
                dirty = dirty + 1
            }

            buffer[0] = 1
            turn = turn + 1
        }

        Test.assert(dirty, 0)
    }

    Test.newTestUnit("Builtins - stack arrays - a copy is memory of its own")
    {
        let [3]i32 first = [1, 2, 3]
        let [3]i32 second = first
        second[0] = 10
        Test.assert(first[0], 1)
        Test.assert(second[0], 10)

        first = second
        Test.assert(first[0], 10)
        second[2] = 30
        Test.assert(first[2], 3)

        first = [4, 5, 6]
        Test.assert(first[1], 5)
    }

    Test.newTestUnit("Builtins - stack arrays - an array of structs, and one of elements that are references")
    {
        let [2]Pixel pixels
        pixels[1].green = 5
        Test.assert(pixels[1].green, 5)
        Test.assert(pixels[0].green, 0)

        let [2]string names = ["a", "b"]
        names[0] = "z"
        Test.assert(names[0], "z")
        Test.assert(names[1], "b")
    }
}
