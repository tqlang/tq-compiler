from Std import { Test }

@public func testStrings() {
    let int number = 5
    let string name = "tq"

    Test.newTestUnit("Builtins - strings - concatenation")
    {
        Test.assert("a" + "b", "ab")
        Test.assert(name + "!", "tq!")
    }

    Test.newTestUnit("Builtins - strings - interpolation")
    {
        Test.assert("n = \{number}", "n = 5")
        Test.assert("hello \{name}", "hello tq")
        Test.assert("\{name}\{number}", "tq5")
    }

    Test.newTestUnit("Builtins - strings - interpolation of an expression")
    {
        Test.assert("sum: \{number + 1}", "sum: 6")
        Test.assert("\{number * number} squared", "25 squared")
    }

    Test.newTestUnit("Builtins - strings - test default formatting")
    {
        let [4]int numbers = [10, 15, 20, 30]
        let []int slice = numbers[1 .. 2]

        Test.assert("numbers = \{numbers}", "numbers = [10, 15, 20, 30]")
        Test.assert("slice = \{slice}", "slice = [15, 20]")
        Test.assert("\{true} \{false}", "true false")
    }

    # Strings on consecutive lines are one string, with a line feed between each two (none after the last).
    Test.newTestUnit("Builtins - strings - strings on consecutive lines are one multiline string")
    {
        let string text = "a"
            "b"
            ""
            "c"
        Test.assert(text, "a\nb\n\nc")

        # A comment or a blank line between them does not stop the sequence.
        let string spaced = "x"
            # comment

            "y"
        Test.assert(spaced, "x\ny")

        let string mixed = "n = \{number}"
            "end"
        Test.assert(mixed, "n = 5\nend")

        # In an argument too; a comma separates.
        Test.assert("p"
            "q", "p\nq")
    }
}
