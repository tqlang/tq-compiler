from Std import { Test }

# The target (.NET) says `int` has 32 bits, so `i32` and `int` are the same integer under two names, and so are `u32` and `uint`.
# The conversion costs nothing (it only loses a tie against an overload that takes the argument as it is), so it beats going to a larger type.
func targetPick(int value) int => 1
func targetPick(i64 value) int => 2

func targetPickUnsigned(uint value) int => 1
func targetPickUnsigned(u64 value) int => 2

func targetTwice(int number) int => number * 2

func targetKeep(int value) int => value

@public func testTargetSizes() {
	let i32 signed = 7
	let u32 unsigned = 7
	let int natural = 7

	Test.newTestUnit("Builtins - target sizes - i32 and int")
	{
		Test.assert(targetPick(signed), 1)
		Test.assert(targetPickUnsigned(unsigned), 1)
		Test.assert(targetTwice(signed), 14)

		# Only from the sized one into `int`; `int` into `iN` is never implicit.
		let int widened = signed
		Test.assert(widened, 7)
		Test.assert(signed + natural, 14)

		# A smaller size widens into `int` (without loss), like into any larger integer.
		let i16 small = 5
		let u16 smallUnsigned = 6
		Test.assert(targetKeep(small), 5)
		Test.assert(targetKeep(smallUnsigned), 6)
		Test.assert(small + natural, 12)
	}
}
