from Std import { Test }

const answer = 42
const greeting = "hi" + "!"
const twoToTen = 2 ** 10
const int typed = 7

@public func testConstants() {
    Test.newTestUnit("Builtins - constants - literal constants")
    {
        Test.assert(answer, 42)
        Test.assert(typed, 7)
    }

    Test.newTestUnit("Builtins - constants - constants that are not literals")
    {
        Test.assert(greeting, "hi!")
        Test.assert(twoToTen, 1024)
    }
    Test.newTestUnit("Builtins - constants - 8-bit min & max")
    {
        Test.assert(u8.min, 0)
        Test.assert(u8.max, 2 ** 8 - 1)
        Test.assert(i8.min, -(2 ** 7))
        Test.assert(i8.max, 2 ** 7 - 1)
    }

    Test.newTestUnit("Builtins - constants - 16-bit min & max")
    {
        Test.assert(u16.min, 0)
        Test.assert(u16.max, 2 ** 16 - 1)
        Test.assert(i16.min, -(2 ** 15))
        Test.assert(i16.max, 2 ** 15 - 1)
    }

    Test.newTestUnit("Builtins - constants - 32-bit min & max")
    {
        Test.assert(u32.min, 0)
        Test.assert(u32.max, 2 ** 32 - 1)
        Test.assert(i32.min, -(2 ** 31))
        Test.assert(i32.max, 2 ** 31 - 1)
    }

    Test.newTestUnit("Builtins - constants - 64-bit min & max")
    {
        Test.assert(u64.min, 0)
        Test.assert(u64.max, 2 ** 64 - 1)
        Test.assert(i64.min, -(2 ** 63))
        Test.assert(i64.max, 2 ** 63 - 1)
    }

    Test.newTestUnit("Builtins - constants - 128-bit min & max")
    {
        Test.assert(u128.min, 0)
        Test.assert(u128.max, 2 ** 128 - 1)
        Test.assert(i128.min, -(2 ** 127))
        Test.assert(i128.max, 2 ** 127 - 1)
    }
}
