from Std import { Test }

const answer = 42
const greeting = "hi" + "!"
const twoToTen = 2 ** 10
const int typed = 7

func testConstants() {
    Test.newTestUnit("constants - literal constants")
    {
        Test.assert(answer, 42)
        Test.assert(typed, 7)
    }

    Test.newTestUnit("constants - constants that are not literals")
    {
        Test.assert(greeting, "hi!")
        Test.assert(twoToTen, 1024)
    }
}
