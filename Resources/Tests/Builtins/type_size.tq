from Std import { Test, Type }

struct SizePair {
	let i32 first
	let i32 second
}

func sizeOfGeneric(type T) uint => Type.SizeOf(T)

# The size of a type is what the target gives it: the backend answers it, and `iptr` is as large as the machine it runs on.
@public func testTypeSize() {
	Test.newTestUnit("Builtins - Std.Type - SizeOf")
	{
		Test.assert(Type.SizeOf(u8) == 1, true)
		Test.assert(Type.SizeOf(i16) == 2, true)
		Test.assert(Type.SizeOf(i32) == 4, true)
		Test.assert(Type.SizeOf(u64) == 8, true)
		Test.assert(Type.SizeOf(f32) == 4, true)
		Test.assert(Type.SizeOf(f64) == 8, true)
		Test.assert(Type.SizeOf(bool) == 1, true)
		Test.assert(Type.SizeOf(int) == Type.SizeOf(i32), true)

		# A struct by value is its fields.
		Test.assert(Type.SizeOf(SizePair) == 8, true)

		# What is as large as a pointer: 4 or 8 bytes, the same for all of them.
		let uint native = Type.SizeOf(iptr)
		Test.assert(native >= 4, true)
		Test.assert(native <= 8, true)
		Test.assert(Type.SizeOf(uptr) == native, true)
		Test.assert(Type.SizeOf(*i32) == native, true)

		# A class is held by a reference, and the type of a generic function is the one it is given.
		Test.assert(Type.SizeOf(string) == native, true)
		Test.assert(sizeOfGeneric(i64) == 8, true)
		Test.assert(sizeOfGeneric(i16) == 2, true)
	}

	Test.newTestUnit("Builtins - Std.Type - BitSizeOf")
	{
		Test.assert(Type.BitSizeOf(u8) == 8, true)
		Test.assert(Type.BitSizeOf(i32) == 32, true)
		Test.assert(Type.BitSizeOf(f64) == 64, true)
		Test.assert(Type.BitSizeOf(iptr) == Type.SizeOf(iptr) * 8, true)
	}
}
