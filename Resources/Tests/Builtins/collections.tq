from Std import { Test }
from Std.Collections import

const size = 3

struct Holder {
    let [3]int values
}

@public func testArraysAndSlices() {
    let [5]int numbers = [10, 20, 30, 40, 50]
    let []int all = &numbers
    let []int middle = numbers[2 .. 3]

    Test.newTestUnit("arrays - array indexing")
    {
        Test.assert(numbers[0], 10)
        Test.assert(numbers[2], 30)
        Test.assert(numbers[4], 50)
        Test.assert(numbers.len, 5)
    }

    Test.newTestUnit("arrays - assigning an array writes the elements")
    {
        numbers = [60, 70, 80, 90, 100]
        Test.assert(numbers[0], 60)
        Test.assert(numbers[4], 100)
    }

    Test.newTestUnit("arrays - declaring with another array copies it")
    {
        let [5]int copy = numbers
        copy[0] = 1
        Test.assert(copy[0], 1)
        Test.assert(numbers[0], 60)
    }

    Test.newTestUnit("arrays - the size is a constant")
    {
        let [2 * 4]int eight
        let [size]int three
        Test.assert(eight.len, 8)
        Test.assert(three.len, 3)
    }

    Test.newTestUnit("arrays - an array field has its memory")
    {
        let Holder holder = new Holder()
        Test.assert(holder.values.len, 3)
        holder.values[1] = 7
        Test.assert(holder.values[1], 7)
        Test.assert(holder.values[0], 0)
    }

    Test.newTestUnit("slices - a slice refers to the array")
    {
        all = &numbers
        Test.assert(all.len, 5)
        all[0] = 11
        Test.assert(numbers[0], 11)
        numbers[1] = 22
        Test.assert(all[1], 22)
    }

    Test.newTestUnit("slices - slice of a range (both ends are included)")
    {
        middle = numbers[2 .. 3]
        Test.assert(middle.len, 2)
        Test.assert(middle[0], 80)
        Test.assert(middle[1], 90)
    }

    Test.newTestUnit("slices - slice modification reflects on array")
    {
        middle[0] = 99
        Test.assert(numbers[2], 99)
        Test.assert(all[2], 99)
    }
}


