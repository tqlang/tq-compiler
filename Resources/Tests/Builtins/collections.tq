from Std import { Test }
from Std.Collections import

const size = 3

struct Holder {
    let [3]int values
}

@public func testArraysAndSlices() {
    let [5]int numbers = [10, 20, 30, 40, 50]
    let []int all = &numbers
    let []int middle = numbers[2 .. 3]

    Test.newTestUnit("Builtins - arrays - array indexing")
    {
        Test.assert(numbers[0], 10)
        Test.assert(numbers[2], 30)
        Test.assert(numbers[4], 50)
        Test.assert(numbers.len, 5)
    }

    Test.newTestUnit("Builtins - arrays - assigning an array writes the elements")
    {
        numbers = [60, 70, 80, 90, 100]
        Test.assert(numbers[0], 60)
        Test.assert(numbers[4], 100)
    }

    Test.newTestUnit("Builtins - arrays - declaring with another array copies it")
    {
        let [5]int copy = numbers
        copy[0] = 1
        Test.assert(copy[0], 1)
        Test.assert(numbers[0], 60)
    }

    Test.newTestUnit("Builtins - arrays - the size is a constant")
    {
        let [2 * 4]int eight
        let [size]int three
        Test.assert(eight.len, 8)
        Test.assert(three.len, 3)
    }

    Test.newTestUnit("Builtins - arrays - an array field has its memory")
    {
        let Holder holder = new Holder()
        Test.assert(holder.values.len, 3)
        holder.values[1] = 7
        Test.assert(holder.values[1], 7)
        Test.assert(holder.values[0], 0)
    }

    Test.newTestUnit("Builtins - slices - a slice refers to the array")
    {
        all = &numbers
        Test.assert(all.len, 5)
        all[0] = 11
        Test.assert(numbers[0], 11)
        numbers[1] = 22
        Test.assert(all[1], 22)
    }

    Test.newTestUnit("Builtins - slices - slice of a range (both ends are included)")
    {
        middle = numbers[2 .. 3]
        Test.assert(middle.len, 2)
        Test.assert(middle[0], 80)
        Test.assert(middle[1], 90)
    }

    Test.newTestUnit("Builtins - slices - slice modification reflects on array")
    {
        middle[0] = 99
        Test.assert(numbers[2], 99)
        Test.assert(all[2], 99)
    }
}

# `[N]T` of a variable is a block of the stack of the function (`stackalloc`) when its elements hold no reference; otherwise it is an array
# of the heap. `[]T` is a view (a `Slice<T>`) of either.
struct Pixel {
    let u8 red = 0
    let u8 green = 0
}

func fillView([]u8 view, u8 value) {
    let int index = 0
    while index < view.len {
        view[index] = value
        index = index + 1
    }
}

func sumOf([]i32 view) i32 {
    let i32 total = 0
    let int index = 0
    while index < view.len {
        total = total + view[index]
        index = index + 1
    }
    return total
}

@public func testStackArrays() {
    Test.newTestUnit("Builtins - stack arrays - a variable that is an array holds its elements")
    {
        let [4]i32 values
        Test.assert(values.len, 4)
        Test.assert(values[0], 0)

        values[1] = 20
        values[3] = 40
        Test.assert(values[1], 20)
        Test.assert(values[3], 40)
        Test.assert(sumOf(&values), 60)
    }

    Test.newTestUnit("Builtins - stack arrays - a literal fills the array, and a view of it writes into it")
    {
        let [3]u8 bytes = [1, 2, 3]
        Test.assert(bytes[2], 3)

        fillView(&bytes, 7)
        Test.assert(bytes[0], 7)
        Test.assert(bytes[2], 7)

        let []u8 part = bytes[1 .. 2]
        part[0] = 9
        Test.assert(bytes[1], 9)
        Test.assert(part.len, 2)
    }

    Test.newTestUnit("Builtins - stack arrays - an array that is declared in a loop is zeroed again and does not grow the stack")
    {
        let int turn = 0
        let int dirty = 0
        while turn < 200000 {
            let [1024]u8 buffer
            if buffer[0] != 0 {
                dirty = dirty + 1
            }

            buffer[0] = 1
            turn = turn + 1
        }

        Test.assert(dirty, 0)
    }

    Test.newTestUnit("Builtins - stack arrays - a copy is memory of its own")
    {
        let [3]i32 first = [1, 2, 3]
        let [3]i32 second = first
        second[0] = 10
        Test.assert(first[0], 1)
        Test.assert(second[0], 10)

        first = second
        Test.assert(first[0], 10)
        second[2] = 30
        Test.assert(first[2], 3)

        first = [4, 5, 6]
        Test.assert(first[1], 5)
    }

    Test.newTestUnit("Builtins - stack arrays - an array of structs, and one of elements that are references")
    {
        let [2]Pixel pixels
        pixels[1].green = 5
        Test.assert(pixels[1].green, 5)
        Test.assert(pixels[0].green, 0)

        let [2]string names = ["a", "b"]
        names[0] = "z"
        Test.assert(names[0], "z")
        Test.assert(names[1], "b")
    }
}

# `[N]T` of a parameter or of what a function returns is passed whole: the callee has a copy of its own.
func bumpFirst([3]i32 values) i32 {
    values[0] = values[0] + 100
    return values[0] + values[1] + values[2]
}

func headOf([3]i32 values) i32 {
    return values[0]
}

func doubledOf([3]i32 values) [3]i32 {
    let [3]i32 result
    let int index = 0
    while index < values.len {
        result[index] = values[index] * 2
        index = index + 1
    }

    return result
}

func handOver([3]i32 values) [3]i32 {
    return values
}

func seriesOf() [3]i32 {
    return [7, 8, 9]
}

func redOfSecond([2]Pixel pixels) u8 {
    return pixels[1].red
}

@public func testArrayParameters() {
    Test.newTestUnit("Builtins - array parameters - the callee changes a copy")
    {
        let [3]i32 values = [1, 2, 3]
        Test.assert(bumpFirst(values), 106)
        Test.assert(values[0], 1)
        Test.assert(headOf(values), 1)
    }

    Test.newTestUnit("Builtins - array parameters - an array is returned by value")
    {
        let [3]i32 values = [1, 2, 3]
        let [3]i32 doubled = doubledOf(values)
        Test.assert(doubled[0], 2)
        Test.assert(doubled[2], 6)
        Test.assert(values[2], 3)

        doubled = handOver(doubled)
        Test.assert(doubled[1], 4)
    }

    Test.newTestUnit("Builtins - array parameters - a returned array is read, sliced and passed on")
    {
        Test.assert(seriesOf()[1], 8)
        Test.assert(seriesOf().len, 3)
        Test.assert("series = \{seriesOf()}", "series = [7, 8, 9]")
        Test.assert(headOf(seriesOf()), 7)
        let [3]i32 series = doubledOf(seriesOf())
        Test.assert(sumOf(&series), 48)

        let [3]i32 source = [4, 5, 6]
        let [3]i32 passed = handOver(source)
        let []i32 view = &passed
        Test.assert(view[2], 6)
    }

    Test.newTestUnit("Builtins - array parameters - an array of structs and a literal as arguments")
    {
        let [2]Pixel pixels
        pixels[1].red = 9
        Test.assert(redOfSecond(pixels), 9)
        let [3]i32 literal = [5, 6, 7]
        Test.assert(headOf(literal), 5)
    }
}
