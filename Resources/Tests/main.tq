from Tests import {
    Builtins
    StdLib
}

@public func runTests() {
    Builtins.testConditionals()
    Builtins.testFunctions()
    Builtins.testProperties()
    Builtins.testConstants()
    Builtins.testStrings()
    Builtins.testProtocols()
    Builtins.testInheritance()
    Builtins.testPolymorphism()
    Builtins.testReferenceConversion()
    Builtins.testValueInheritance()
    Builtins.testValuePolymorphism()

    Builtins.testArraysAndSlices()

    Builtins.testBuiltins()
    Builtins.testNullables()
    Builtins.testFailables()

    Builtins.testArithmeticU8()
    Builtins.testArithmeticI8()
    Builtins.testArithmeticU16()
    Builtins.testArithmeticI16()
    Builtins.testArithmeticU32()
    Builtins.testArithmeticI32()
    Builtins.testArithmeticU64()
    Builtins.testArithmeticI64()
    Builtins.testArithmeticU128()
    Builtins.testArithmeticI128()

    # test STD lib
    StdLib.testDynamicArray()
    StdLib.testDictionaries()
    StdLib.testGenericInterfaces()
}
