from Std import { Test }

func testArithmeticU16() {
	let u16 u16_0 = 0
	let u16 u16_1 = 1
	let u16 u16_2 = 2
	let u16 u16_3 = 3
	let u16 u16_4 = 4
	let u16 u16_5 = 5
	let u16 u16_6 = 6
	let u16 u16_7 = 7
	let u16 u16_8 = 8
	let u16 u16_9 = 9
	let u16 u16_100 = 100
	let u16 u16_101 = 101
	let u16 u16_255 = 255
	let u16 u16_500 = 500
	let u16 u16_min = u16.min
	let u16 u16_max = u16.max
	
	Test.newTestUnit("u16 arithmetic - checked add")
	Test.assert(u16_1 + u16_1, 2)
	Test.assert(u16_2 + u16_2, 4)
	Test.assert(u16_max + 0, u16_max)
	#Test.assert(u16_max + 1, ?) #!! FATAL ERROR !!
	#Test.assert(u16_max + 100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("u16 arithmetic - add with overflow")
	Test.assert(u16_1 +% u16_1, 2)
	Test.assert(u16_2 +% u16_2, 4)
	Test.assert(u16_max +% u16_0, u16_max)
	Test.assert(u16_max +% u16_1, u16_min)
	Test.assert(u16_max +% u16_100, 99)

	Test.newTestUnit("u16 arithmetic - add saturated")
	Test.assert(u16_1 +| u16_1, 2)
	Test.assert(u16_2 +| u16_2, 4)
	Test.assert(u16_max +| u16_0, u16_max)
	Test.assert(u16_max +| u16_1, u16_max)
	Test.assert(u16_max +| u16_100, u16_max)


	Test.newTestUnit("u16 arithmetic - checked sub")
	Test.assert(u16_1 - u16_1, 0)
	Test.assert(u16_2 - u16_1, 1)
	Test.assert(u16_0 - u16_0, 0)
	#Test.assert(u16_1 - u16_2, ?) #!! FATAL ERROR !!
	#Test.assert(u16_0 - 100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("u16 arithmetic - sub with overflow")
	Test.assert(u16_1 -% u16_1, 0)
	Test.assert(u16_2 -% u16_1, 1)
	Test.assert(u16_0 -% u16_0, 0)
	Test.assert(u16_1 -% u16_2, 65535)
	Test.assert(u16_0 -% 100, 65436)

	Test.newTestUnit("u16 arithmetic - sub saturated")
	Test.assert(u16_1 -| u16_1, 0)
	Test.assert(u16_2 -| u16_1, 1)
	Test.assert(u16_0 -| u16_0, 0)
	Test.assert(u16_1 -| u16_2, 0)
	Test.assert(u16_0 -| 100, 0)

	Test.newTestUnit("u16 arithmetic - mul checked")
	Test.assert(u16_1 * u16_1, 1)
	Test.assert(u16_2 * u16_2, 4)
	Test.assert(u16_2 * u16_100, 200)
	Test.assert(u16_0 * u16_100, 0)
	#Test.assert(u16_100 * u16_100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("u16 arithmetic - mul with overflow")
	Test.assert(u16_1 *% u16_1, 1)
	Test.assert(u16_2 *% u16_2, 4)
	Test.assert(u16_2 *% u16_100, 200)
	Test.assert(u16_100 *% u16_100, 10000)
	Test.assert(u16_max *% u16_2, 65534)

	Test.newTestUnit("u16 arithmetic - mul saturated")
	Test.assert(u16_1 *| u16_1, 1)
	Test.assert(u16_2 *| u16_2, 4)
	Test.assert(u16_2 *| u16_100, 200)
	Test.assert(u16_500 *| u16_500, 65535)
	Test.assert(u16_max *| u16_2, u16_max)

	Test.newTestUnit("u16 arithmetic - div checked")
	Test.assert(u16_2 / u16_1, 2)
	Test.assert(u16_100 / u16_2, 50)
	Test.assert(u16_0 / u16_100, 0)
	#Test.assert(u16_1 / u16_2, ?) #!! FATAL ERROR !!
	#Test.assert(u16_1 / u16_0, ?) #!! FATAL ERROR !!

	Test.newTestUnit("u16 arithmetic - div floor")
	Test.assert(u16_2 /_ u16_1, 2)
	Test.assert(u16_100 /_ u16_2, 50)
	Test.assert(u16_1 /_ u16_2, 0)
	Test.assert(u16_0 /_ u16_100, 0)

	Test.newTestUnit("u16 arithmetic - div ceil")
	Test.assert(u16_2 /^ u16_1, 2)
	Test.assert(u16_100 /^ u16_2, 50)
	Test.assert(u16_1 /^ u16_2, 1)
	Test.assert(u16_3 /^ u16_2, 2)
	Test.assert(u16_0 /^ u16_100, 0)

	Test.newTestUnit("u16 arithmetic - reminder")
	Test.assert(u16_2 % u16_1, 0)
	Test.assert(u16_100 % u16_2, 0)
	Test.assert(u16_101 % u16_2, 1)
	Test.assert(u16_255 % u16_2, 1)
	Test.assert(u16_0 % u16_100, 0)
	#Test.assert(u16_1 % u16_0, ?)
	
	Test.newTestUnit("u16 arithmetic - pow checked")
	Test.assert(u16_2 ** u16_1, 2)
	Test.assert(u16_2 ** u16_2, 4)
	Test.assert(u16_2 ** u16_3, 8)
	Test.assert(u16_1 ** u16_100, 1)
	Test.assert(u16_0 ** u16_1, 0)
	Test.assert(u16_0 ** u16_0, 1)
	# #Test.assert(u16_2 ** u16_8, ?) #!! FATAL ERROR !!

	Test.newTestUnit("u16 arithmetic - pow with overflow")
	Test.assert(u16_2 **% u16_8, 256)
	Test.assert(u16_2 **% u16_9, 512)
	Test.assert(u16_3 **% u16_5, 243)
	Test.assert(u16_5 **% u16_4, 625)

	Test.newTestUnit("u16 arithmetic - pow saturated")
	Test.assert(u16_2 **| u16_3, 8)
	Test.assert(u16_2 **| u16_7, 128)
	Test.assert(u16_100 **| u16_8, u16_max)
	Test.assert(u16_100 **| u16_6, u16_max)
}

func testArithmeticI16() {
	let i16 i16_0 = 0
	let i16 i16_1 = 1
	let i16 i16_2 = 2
	let i16 i16_3 = 3
	let i16 i16_4 = 4
	let i16 i16_5 = 5
	let i16 i16_6 = 6
	let i16 i16_7 = 7
	let i16 i16_8 = 8
	let i16 i16_9 = 9
	let i16 i16_16 = 16
	let i16 i16_100 = 100
	let i16 i16_101 = 101
	let i16 i16_127 = 127
	let i16 i16_256 = 256
	let i16 i16_min = i16.min
	let i16 i16_max = i16.max
	
	Test.newTestUnit("i16 arithmetic - checked add")
	Test.assert(i16_1 + i16_1, 2)
	Test.assert(i16_2 + i16_2, 4)
	Test.assert(i16_max + 0, i16_max)
	#Test.assert(i16_max + 1, ?) #!! FATAL ERROR !!
	#Test.assert(i16_max + 100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("i16 arithmetic - add with overflow")
	Test.assert(i16_1 +% i16_1, 2)
	Test.assert(i16_2 +% i16_2, 4)
	Test.assert(i16_max +% i16_0, i16_max)
	Test.assert(i16_max +% i16_1, i16_min)
	Test.assert(i16_max +% i16_100, -32669)

	Test.newTestUnit("i16 arithmetic - add saturated")
	Test.assert(i16_1 +| i16_1, 2)
	Test.assert(i16_2 +| i16_2, 4)
	Test.assert(i16_max +| i16_0, i16_max)
	Test.assert(i16_max +| i16_1, i16_max)
	Test.assert(i16_max +| i16_100, i16_max)

	Test.newTestUnit("i16 arithmetic - checked sub")
	Test.assert(i16_1 - i16_1, 0)
	Test.assert(i16_2 - i16_1, 1)
	Test.assert(i16_0 - i16_0, 0)
	#Test.assert(i16_1 - i16_2, ?) #!! FATAL ERROR !!
	#Test.assert(i16_0 - 100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("i16 arithmetic - sub with overflow")
	Test.assert(i16_1 -% i16_1, 0)
	Test.assert(i16_2 -% i16_1, 1)
	Test.assert(i16_0 -% i16_0, 0)
	Test.assert(i16_1 -% i16_2, -1)
	Test.assert(i16_0 -% 100, -100)

	Test.newTestUnit("i16 arithmetic - sub saturated")
	Test.assert(i16_1 -| i16_1, 0)
	Test.assert(i16_2 -| i16_1, 1)
	Test.assert(i16_0 -| i16_0, 0)
	Test.assert(i16_1 -| i16_2, -1)
	Test.assert(i16_0 -| 100, -100)

	Test.newTestUnit("i16 arithmetic - mul checked")
	Test.assert(i16_1 * i16_1, 1)
	Test.assert(i16_2 * i16_2, 4)
	#Test.assert(i16_2 * i16_100, 200) #!! FATAL ERROR !!
	Test.assert(i16_0 * i16_100, 0)
	#Test.assert(i16_100 * i16_100, ?) #!! FATAL ERROR !!

	Test.newTestUnit("i16 arithmetic - mul with overflow")
	Test.assert(i16_1 *% i16_1, 1)
	Test.assert(i16_2 *% i16_2, 4)
	Test.assert(i16_2 *% i16_100, 200)
	Test.assert(i16_256 *% i16_101, 25856)
	Test.assert(i16_max *% i16_2, -2)

	Test.newTestUnit("i16 arithmetic - mul saturated")
	Test.assert(i16_1 *| i16_1, 1)
	Test.assert(i16_2 *| i16_2, 4)
	Test.assert(i16_2 *| i16_100, 200)
	Test.assert(i16_100 *| i16_100, 10000)
	Test.assert(i16_max *| i16_2, i16_max)

	Test.newTestUnit("i16 arithmetic - div checked")
	Test.assert(i16_2 / i16_1, 2)
	Test.assert(i16_100 / i16_2, 50)
	Test.assert(i16_0 / i16_100, 0)
	#Test.assert(i16_1 / i16_2, ?) #!! FATAL ERROR !!
	#Test.assert(i16_1 / i16_0, ?) #!! FATAL ERROR !!

	Test.newTestUnit("i16 arithmetic - div floor")
	Test.assert(i16_2 /_ i16_1, 2)
	Test.assert(i16_100 /_ i16_2, 50)
	Test.assert(i16_1 /_ i16_2, 0)
	Test.assert(i16_0 /_ i16_100, 0)

	Test.newTestUnit("i16 arithmetic - div ceil")
	Test.assert(i16_2 /^ i16_1, 2)
	Test.assert(i16_100 /^ i16_2, 50)
	Test.assert(i16_1 /^ i16_2, 1)
	Test.assert(i16_3 /^ i16_2, 2)
	Test.assert(i16_0 /^ i16_100, 0)

	Test.newTestUnit("i16 arithmetic - reminder")
	Test.assert(i16_2 % i16_1, 0)
	Test.assert(i16_100 % i16_2, 0)
	Test.assert(i16_101 % i16_2, 1)
	Test.assert(i16_127 % i16_2, 1)
	Test.assert(i16_0 % i16_100, 0)
	#Test.assert(i16_1 % i16_0, ?)
	
	Test.newTestUnit("i16 arithmetic - pow checked")
	Test.assert(i16_2 ** i16_1, 2)
	Test.assert(i16_2 ** i16_2, 4)
	Test.assert(i16_2 ** i16_3, 8)
	Test.assert(i16_1 ** i16_100, 1)
	Test.assert(i16_0 ** i16_1, 0)
	Test.assert(i16_0 ** i16_0, 1)
	#Test.assert(i16_2 ** i16_8, ?) #!! FATAL ERROR !!

	Test.newTestUnit("i16 arithmetic - pow with overflow")
	Test.assert(i16_2 **% i16_16, 0)
	Test.assert(i16_2 **% i16_9, 512)
	Test.assert(i16_3 **% i16_5, 243)
	Test.assert(i16_5 **% i16_4, 625)

	Test.newTestUnit("i16 arithmetic - pow saturated")
	Test.assert(i16_2 **| i16_3, 8)
	Test.assert(i16_2 **| i16_7, 128)
	Test.assert(i16_2 **| i16_16, i16_max)
	Test.assert(i16_3 **| i16_16, i16_max)
}
