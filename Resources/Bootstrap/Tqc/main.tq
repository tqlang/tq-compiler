from Std.Console import
from Std.Process import
from Std.Log import
from Tests import { runTests }

@public func main() {
    let log = new Logger("main")

    log.info("Hello, World!")

    if (true) {
        log.debug("It looks like the compiler is working!")
    }

    let args = getProgramArguments()
    log.warn("Program arguments:")
    while (let i = 0 : i < args.len : i++) log.warn(" - " + args[i])

    writeln()
    runTests()
}
