# @public func writeln(u64 value) { out.writeln(value as string) }
# @public func writeln(i128 value) { out.writeln(value as string) }
# @public func writeln(u128 value) { out.writeln(value as string) }
# @public func writeln([]anytype value) { out.writeln(value as string) }
# @public func writeln(string value) { out.writeln(value) }
