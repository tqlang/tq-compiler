from Std.Io import

const _out = new StdoutWriter()
#@public let out => _out
@public func getOut() *TextWriter { return _out }

const _in = new StdinReader()
#@public let in => _in
@public func getIn() *TextReader { return _in }

@public func write(i64 value) { _out.write(value as string) }
@public func write(u64 value) { _out.write(value as string) }
@public func write(i128 value) { _out.write(value as string) }
@public func write(u128 value) { _out.write(value as string) }
@public func write([]anytype value) { _out.write(value as string) }
@public func write(string value) { _out.write(value) }

@public func writeln(i64 value) { _out.writeLine(value as string) }
@public func writeln(u64 value) { _out.writeLine(value as string) }
@public func writeln(i128 value) { _out.writeLine(value as string) }
@public func writeln(u128 value) { _out.writeLine(value as string) }
@public func writeln([]anytype value) { _out.writeLine(value as string) }
@public func writeln(string value) { _out.writeLine(value) }
@public func writeln() { _out.writeLine("") }
