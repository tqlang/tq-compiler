from Std.Io import
from Dotnet.System import { Console }

@private struct StdoutWriter
	extends Stream
	implements TextWriter
{

	@public @override func write(string value) {
		Console.Out.Write(value)
	}

	@public @override func writeLine(string value) {
		Console.Out.WriteLine(value)
	}

	@public @override func flush() {
		Console.Out.Flush()
	}
}
