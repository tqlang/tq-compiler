from Std import { Console }

@public struct Logger {

	let string scope

	@public constructor(string scope) {
		this.scope = scope
	}

	@public func debug(string value) { log_raw(LogLevel.debug, scope, value) }
	@public func warn(string value) { log_raw(LogLevel.warn, scope, value) }
	@public func info(string value) { log_raw(LogLevel.info, scope, value) }
	@public func err(string value) { log_raw(LogLevel.error, scope, value) }

}

func log_raw(LogLevel level, string scope, string message) {
	let value = ""

	match (level) {
		case LogLevel.debug => value += Console.color_black +  "[DEBUG] "
		case LogLevel.warn =>  value += Console.color_yellow + "[WARN ] "
		case LogLevel.info =>  value += Console.color_white +  "[INFO ] "
		case LogLevel.error => value += Console.color_red +    "[ERROR] "
	}

	value += scope + ": "
	value += message
	value += Console.style_reset

	match (level) {
		case LogLevel.info =>  Console.out.writeLine(value)
		case LogLevel.debug, LogLevel.warn, LogLevel.error => Console.err.writeLine(value)
	}
}

