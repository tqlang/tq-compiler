<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The assembly that the compiled Tq programs use. The compiler copies it to the output of a build, after adding to it
        what depends on the code being compiled (see Tqc.Backend.Cecil/TqRuntimeAssembly.cs).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Tq.Runtime</AssemblyName>
        <RootNamespace>Tq</RootNamespace>
        <Version>1.0.0</Version>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <Optimize>true</Optimize>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- the compiler rewrites the assembly, so its symbols would not match it -->
        <DebugType>none</DebugType>
    </PropertyGroup>

</Project>
